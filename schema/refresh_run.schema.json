{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-catalog.local/schema/refresh_run.schema.json",
  "title": "RefreshRun",
  "description": "One provider's outcome within one refresh invocation, so a gap in the price or availability series can be told apart from an unchanged value.",
  "type": "object",
  "required": [
    "ts",
    "job",
    "provider",
    "status"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "job": {
      "enum": [
        "pricing",
        "availability",
        "capacity",
        "discovery"
      ]
    },
    "provider": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "skipped"
      ]
    },
    "duration_sec": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "retired": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "price_rows": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        },
        "matched_skus": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "written": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
