{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-catalog.local/schema/availability.schema.json",
  "title": "AvailabilityObservation",
  "type": "object",
  "required": [
    "ts",
    "provider",
    "region",
    "gpu",
    "shape",
    "available_gpus",
    "available_vms",
    "spot_available_gpus",
    "spot_available_vms",
    "vms_derived",
    "observed_via",
    "confidence"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "gpu": {
      "type": "string"
    },
    "shape": {
      "enum": [
        "1x",
        "2x",
        "4x",
        "8x"
      ]
    },
    "variant": {
      "type": [
        "string",
        "null"
      ]
    },
    "available_gpus": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "available_vms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "spot_available_gpus": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "spot_available_vms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_gpus": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "vms_derived": {
      "type": "boolean",
      "description": "True when available_vms was derived as floor(available_gpus / gpus_per_vm) rather than reported by the provider."
    },
    "observed_via": {
      "enum": [
        "api",
        "console",
        "probe",
        "page",
        "manual"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "additionalProperties": false
}
